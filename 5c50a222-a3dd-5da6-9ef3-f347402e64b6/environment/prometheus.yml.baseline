global:
  scrape_interval: 5s
  scrape_timeout: 4s
  evaluation_interval: 5s
  external_labels:
    monitor: forge-inv25

scrape_configs:
  - job_name: app
    metrics_path: /metrics
    scheme: http
    static_configs:
      - targets:
          - 127.0.0.1:8080
        labels:
          instance: app-local
