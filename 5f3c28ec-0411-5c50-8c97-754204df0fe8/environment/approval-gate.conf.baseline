server {
    listen 127.0.0.1:80 default_server;
    server_name _;

    location = /health {
        proxy_pass http://127.0.0.1:8080/health;
        proxy_set_header Host $host;
    }

    location = /request-approval {
        if ($request_method != POST) { return 405; }
        auth_request /_verify_token;
        proxy_pass http://127.0.0.1:8080/request-approval;
        proxy_set_header Host $host;
        proxy_set_header X-Approval-Token $http_x_approval_token;
        proxy_pass_request_body on;
    }

    location = /apply-restore {
        if ($request_method != POST) { return 405; }
        auth_request /_verify_token;
        proxy_pass http://127.0.0.1:8080/apply;
        proxy_set_header Host $host;
        proxy_set_header X-Approval-Token $http_x_approval_token;
        proxy_pass_request_body on;
    }

    location = /_verify_token {
        internal;
        proxy_pass http://127.0.0.1:8080/verify-token-edge;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Approval-Token $http_x_approval_token;
        proxy_set_header X-Original-URI $request_uri;
    }

    location / {
        return 404;
    }
}
