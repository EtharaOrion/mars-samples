; /etc/pgbouncer/pgbouncer.ini — healthy baseline for FORGE inv-27.
; corruption_bootstrap.sh at image build time applies sed -i to set
;   pool_mode = transaction   (P1 seed)
;   max_client_conn = 20      (P3 seed)
; The agent's patch.sh must restore these to session/100 (or the
; C-ORDERING equivalent PSYCOPG2_PREPARE_THRESHOLD=None in
; /etc/app/config.py) and reload pgbouncer.

[databases]
appdb = host=127.0.0.1 port=5432 dbname=appdb

[pgbouncer]
listen_addr = 127.0.0.1
listen_port = 6432
unix_socket_dir = /var/run/pgbouncer
auth_type = trust
auth_file = /etc/pgbouncer/userlist.txt
admin_users = pgbouncer
stats_users = pgbouncer

pool_mode = session
max_client_conn = 100
default_pool_size = 20
min_pool_size = 5
reserve_pool_size = 5
reserve_pool_timeout = 3

server_lifetime = 3600
server_idle_timeout = 600
server_connect_timeout = 15
server_login_retry = 5
client_login_timeout = 30
query_wait_timeout = 60

logfile = /var/log/pgbouncer/pgbouncer.log
pidfile = /var/run/pgbouncer/pgbouncer.pid
log_connections = 1
log_disconnections = 1
log_pooler_errors = 1
