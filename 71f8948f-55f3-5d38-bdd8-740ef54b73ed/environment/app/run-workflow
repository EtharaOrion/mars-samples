#!/usr/bin/env python3
"""Minimal, deterministic GitHub-Actions-style workflow runner (stdlib only).

This is an OFFLINE stand-in for `act` / real GitHub runners. It parses a
constrained subset of workflow YAML and executes it in-container:

  * top-level `env:` plus per-job `env:` and per-step `env:` are merged
    (step > job > workflow) into the process environment of each `run:` block;
  * job execution order is a stable topological sort over `needs:`;
  * each step honors its `working-directory:` (relative to the repo root, i.e.
    the current working directory) and runs its `run:` block via `/bin/sh -c`;
  * the first step that exits non-zero fails the whole workflow.

A per-run log is written to `_runlog.txt` in the repo root: one `EXEC ...` line
per executed step (job, step name, working directory, exit code, command).

Usage: python3 run-workflow <path-to-workflow.yml>
"""
import os
import subprocess
import sys


# --------------------------- tiny YAML subset loader -----------------------

def _indent(s):
    return len(s) - len(s.lstrip(" "))


def _is_blank(s):
    t = s.strip()
    return t == "" or t.startswith("#")


def _strip_comment(s):
    out = []
    q = None
    i = 0
    while i < len(s):
        c = s[i]
        if q is not None:
            out.append(c)
            if c == q:
                q = None
        elif c in ("'", '"'):
            q = c
            out.append(c)
        elif c == "#" and (i == 0 or s[i - 1] in (" ", "\t")):
            break
        else:
            out.append(c)
        i += 1
    return "".join(out).rstrip()


def _split_flow(inner):
    parts = []
    buf = []
    q = None
    for c in inner:
        if q is not None:
            buf.append(c)
            if c == q:
                q = None
        elif c in ("'", '"'):
            q = c
            buf.append(c)
        elif c == ",":
            parts.append("".join(buf).strip())
            buf = []
        else:
            buf.append(c)
    if "".join(buf).strip() != "":
        parts.append("".join(buf).strip())
    return parts


def _scalar(tok):
    tok = tok.strip()
    if tok == "" or tok == "~" or tok == "null":
        return None
    if len(tok) >= 2 and tok[0] == tok[-1] and tok[0] in ("'", '"'):
        return tok[1:-1]
    if tok.startswith("[") and tok.endswith("]"):
        inner = tok[1:-1].strip()
        if inner == "":
            return []
        return [_scalar(x) for x in _split_flow(inner)]
    return tok


def _looks_like_key(s):
    # matches `key:` or `key: value`
    i = 0
    n = len(s)
    if n == 0:
        return False
    while i < n and (s[i].isalnum() or s[i] in "_-."):
        i += 1
    if i == 0:
        return False
    return i < n and s[i] == ":" and (i + 1 == n or s[i + 1] == " ")


def _next_content(lines, i):
    n = len(lines)
    while i < n and _is_blank(lines[i]):
        i += 1
    return i


def _parse_block(lines, i, min_indent):
    j = _next_content(lines, i)
    if j >= len(lines):
        return None, j
    cur = _indent(lines[j])
    if cur < min_indent:
        return None, i
    body = lines[j].strip()
    if body.startswith("- ") or body == "-":
        return _parse_seq(lines, j, cur)
    return _parse_map(lines, j, cur)


def _block_scalar(lines, i, key_indent):
    # consume lines more indented than key_indent (literal '|' style)
    n = len(lines)
    collected = []
    base = None
    k = i
    while k < n:
        if lines[k].strip() == "":
            collected.append("")
            k += 1
            continue
        ind = _indent(lines[k])
        if ind <= key_indent:
            break
        if base is None:
            base = ind
        collected.append(lines[k][base:])
        k += 1
    while collected and collected[-1] == "":
        collected.pop()
    return "\n".join(collected), k


def _parse_map(lines, i, indent):
    node = {}
    n = len(lines)
    k = i
    while k < n:
        if _is_blank(lines[k]):
            k += 1
            continue
        ind = _indent(lines[k])
        if ind < indent:
            break
        if ind > indent:
            break
        line = _strip_comment(lines[k])
        stripped = line.strip()
        if ":" not in stripped:
            break
        key, _, rest = stripped.partition(":")
        key = key.strip()
        rest = rest.strip()
        if rest in ("|", "|-", ">", ">-"):
            val, k = _block_scalar(lines, k + 1, indent)
            node[key] = val
            continue
        if rest == "":
            j = _next_content(lines, k + 1)
            if j < n and not _is_blank(lines[j]):
                cj = _indent(lines[j])
                sj = lines[j].strip()
                if cj > indent:
                    val, k = _parse_block(lines, k + 1, cj)
                    node[key] = val
                    continue
                if cj == indent and (sj.startswith("- ") or sj == "-"):
                    val, k = _parse_seq(lines, j, cj)
                    node[key] = val
                    continue
            node[key] = None
            k += 1
            continue
        node[key] = _scalar(rest)
        k += 1
    return node, k


def _parse_seq(lines, i, indent):
    items = []
    n = len(lines)
    k = i
    while k < n:
        if _is_blank(lines[k]):
            k += 1
            continue
        ind = _indent(lines[k])
        if ind != indent:
            break
        line = _strip_comment(lines[k])
        stripped = line.strip()
        if not (stripped.startswith("- ") or stripped == "-"):
            break
        rest = stripped[1:].lstrip()
        if rest == "":
            val, k = _parse_block(lines, k + 1, indent + 1)
            items.append(val)
            continue
        # gather continuation lines (indent greater than this item marker)
        m = k + 1
        while m < n and (_is_blank(lines[m]) or _indent(lines[m]) > ind):
            m += 1
        if _looks_like_key(rest):
            synth = [" " * (ind + 2) + rest] + lines[k + 1:m]
            val, _ = _parse_map(synth, 0, ind + 2)
            items.append(val)
        else:
            items.append(_scalar(rest))
        k = m
    return items, k


def load_yaml(text):
    lines = text.replace("\t", "    ").split("\n")
    node, _ = _parse_block(lines, 0, 0)
    return node if node is not None else {}


# ------------------------------- runner ------------------------------------

def _as_list(v):
    if v is None:
        return []
    if isinstance(v, list):
        return v
    return [v]


def order_jobs(jobs):
    names = list(jobs.keys())
    deps = {}
    for name in names:
        job = jobs[name] or {}
        deps[name] = [d for d in _as_list(job.get("needs")) if d in jobs]
    order = []
    done = set()
    while len(order) < len(names):
        progressed = False
        for name in names:
            if name in done:
                continue
            if all(d in done for d in deps[name]):
                order.append(name)
                done.add(name)
                progressed = True
        if not progressed:
            raise SystemExit("run-workflow: cycle or unknown dependency in needs:")
    return order


def _env_map(node):
    env = {}
    if isinstance(node, dict):
        for k, v in node.items():
            env[str(k)] = "" if v is None else str(v)
    return env


def main(argv):
    if len(argv) != 2:
        sys.stderr.write("usage: run-workflow <workflow.yml>\n")
        return 2
    with open(argv[1], "r", encoding="utf-8") as fh:
        doc = load_yaml(fh.read())
    if not isinstance(doc, dict) or "jobs" not in doc or not isinstance(doc["jobs"], dict):
        sys.stderr.write("run-workflow: no jobs found\n")
        return 2

    wf_env = _env_map(doc.get("env"))
    jobs = doc["jobs"]
    log = []
    rc_final = 0
    for job_name in order_jobs(jobs):
        job = jobs[job_name] or {}
        job_env = _env_map(job.get("env"))
        steps = job.get("steps") or []
        if not isinstance(steps, list):
            steps = []
        for step in steps:
            if not isinstance(step, dict):
                continue
            run = step.get("run")
            if run is None:
                continue
            step_env = _env_map(step.get("env"))
            wd = step.get("working-directory") or "."
            name = step.get("name") or "run"
            first = str(run).strip().splitlines()[0] if str(run).strip() else ""
            if not os.path.isdir(wd):
                log.append(
                    "EXEC job=%s step=%s dir=%s rc=1 :: %s" % (job_name, name, wd, first)
                )
                _flush(log)
                sys.stderr.write(
                    "run-workflow: working-directory does not exist: %s\n" % wd
                )
                return 1
            env = dict(os.environ)
            env.update(wf_env)
            env.update(job_env)
            env.update(step_env)
            proc = subprocess.run(
                ["/bin/sh", "-c", str(run)],
                cwd=wd,
                env=env,
            )
            rc = proc.returncode
            log.append(
                "EXEC job=%s step=%s dir=%s rc=%d :: %s"
                % (job_name, name, wd, rc, first)
            )
            if rc != 0:
                rc_final = rc
                _flush(log)
                sys.stderr.write("run-workflow: step failed in job '%s'\n" % job_name)
                return rc_final
    _flush(log)
    return rc_final


def _flush(log):
    with open("_runlog.txt", "w", encoding="utf-8") as fh:
        fh.write("\n".join(log) + ("\n" if log else ""))


if __name__ == "__main__":
    sys.exit(main(sys.argv))
