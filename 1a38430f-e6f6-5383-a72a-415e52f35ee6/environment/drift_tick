#!/bin/bash
# Fire one drift state (M1, M2, or M3) and touch mutation_tick.
# Cycles M1 -> M2 -> M3 via /var/lib/redis/drift_cycle_state.
set -u
SOCK=/var/run/redis/redis.sock
STATE=/var/lib/redis/drift_cycle_state
TICK=/var/lib/redis/mutation_tick
TLS=/etc/redis/tls

if [ ! -S "$SOCK" ]; then
    # Redis has not started yet; still advance mutation_tick so the loop
    # signals liveness once redis is up.
    date +%s > "$TICK"
    exit 0
fi

CUR=0
if [ -f "$STATE" ]; then
    CUR=$(cat "$STATE" 2>/dev/null || echo 0)
fi

NEXT=$(( (CUR + 1) % 3 ))
echo "$NEXT" > "$STATE"

case "$CUR" in
    0)
        # M1: silent persistence flip (in-memory only, no CONFIG REWRITE).
        redis-cli -s "$SOCK" CONFIG SET appendonly no >/dev/null 2>&1 || true
        ;;
    1)
        # M2: silent eviction-policy flip (in-memory only).
        redis-cli -s "$SOCK" CONFIG SET maxmemory-policy noeviction >/dev/null 2>&1 || true
        ;;
    2)
        # M3: Server-cert rotation only.  Swap redis.crt/redis.key with
        # their .new counterparts (both re-signed by the new CA) and
        # reload the two server-cert paths.  ca.crt is NOT touched here
        # and tls-ca-cert-file is NOT reloaded; those steps belong to
        # the agent's reconcile.sh so omitting them is observable at
        # the verifier.
        if [ -f "$TLS/redis.crt.new" ]; then
            mv -f "$TLS/redis.crt.new" "$TLS/redis.crt"
        fi
        if [ -f "$TLS/redis.key.new" ]; then
            mv -f "$TLS/redis.key.new" "$TLS/redis.key"
        fi
        redis-cli -s "$SOCK" CONFIG SET tls-cert-file "$TLS/redis.crt" >/dev/null 2>&1 || true
        redis-cli -s "$SOCK" CONFIG SET tls-key-file  "$TLS/redis.key" >/dev/null 2>&1 || true
        ;;
esac

date +%s > "$TICK"
exit 0
